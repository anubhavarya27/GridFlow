# Local TimescaleDB container initialization
POSTGRES_PASSWORD=replace_with_a_local_password

# Spring Boot database connection; match POSTGRES_PASSWORD
GRIDFLOW_DB_PASSWORD=replace_with_the_same_database_password

# Base64-encoded random secret; decode to at least 32 bytes
GRIDFLOW_JWT_SECRET=replace_with_a_base64_encoded_secret

# BCrypt hash of the approval password
GRIDFLOW_APPROVAL_PASSWORD_HASH=replace_with_a_real_bcrypt_hash
