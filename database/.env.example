# database/.env  (copy from this file; database/.env is git-ignored)
# Choose your own values. These are used only by docker-compose.yml and
# the setup scripts. Put the same GRIDPULSE_APP_PASSWORD into backend/.env as DB_PASSWORD.

POSTGRES_PASSWORD=change-me-postgres-superuser
GRIDPULSE_APP_PASSWORD=change-me-gridpulse-app
MYSQL_ROOT_PASSWORD=change-me-mysql-root
GRIDPULSE_MYSQL_RO_PASSWORD=change-me-mysql-readonly
PG_PORT=5432
MYSQL_PORT=3306
